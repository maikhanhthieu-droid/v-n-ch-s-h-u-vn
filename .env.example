# Create a new token with @BotFather after rotating any token shared in chat.
TELEGRAM_BOT_TOKEN=

# Optional settings
POLL_TIMEOUT=25
YAHOO_TIMEOUT=12
DATA_DIR=data

# Optional deep-signal scanner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_GOOGLE_SEARCH=false
GEMINI_TIMEOUT=30
GEMINI_MIN_INTERVAL=4
GEMINI_CACHE_TTL=1800
GEMINI_QUOTA_COOLDOWN=900
SCAN_WEEKDAYS=0,3
SCAN_TIME=20:30
SCAN_WORKERS=4
MONTHLY_SIGNAL_LIMIT=2
MAX_SIGNALS_PER_SCAN=2
MIN_SIGNAL_SCORE=70
SIGNAL_COOLDOWN_DAYS=30
VN100_SYMBOLS=
