# Create a new token with @BotFather after rotating any token shared in chat.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs allowed to use the bot. When this is blank,
# TELEGRAM_CHAT_ID is used as the single-chat backward-compatible fallback.
TELEGRAM_ALLOWED_CHAT_IDS=
TELEGRAM_CHAT_ID=

# Optional settings
POLL_TIMEOUT=25
YAHOO_TIMEOUT=12
DATA_DIR=data

# Optional VNStock routed OHLCV: VCI <-> KBS, then Yahoo fallback.
VNSTOCK_API_KEY=
VNSTOCK_SOURCES=VCI,KBS
VNSTOCK_DAILY_BUDGET=60
VNSTOCK_REQUESTS_PER_MINUTE=12
VNSTOCK_USAGE_RATIO=0.70
VNSTOCK_ERROR_COOLDOWN=300
VNSTOCK_CACHE_TTL=480

# Optional deep-signal scanner
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
GEMINI_THINKING_LEVEL=minimal
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_GOOGLE_SEARCH=false
GEMINI_TIMEOUT=30
GEMINI_MIN_INTERVAL=60
GEMINI_CACHE_TTL=1800
GEMINI_QUOTA_COOLDOWN=900
RESEARCH_COMMAND_COOLDOWN=60
GEMINI_DAILY_BUDGET=6
DEEP_DAILY_LIMIT=3
SCAN_DAILY_LIMIT=1
NEWS_DAILY_LIMIT=8
SCAN_WEEKDAYS=0,3
SCAN_TIME=20:30
SCAN_WORKERS=2
DAILY_SHORTLIST_LIMIT=3
MAX_SIGNALS_PER_SCAN=3
MIN_SIGNAL_SCORE=70
VN100_SYMBOLS=

# Production scan gate. Values are percentages except expectancy (R multiple).
SIGNAL_REQUIRE_BACKTEST=true
SIGNAL_REQUIRE_DATED_HISTORY=true
MAX_HISTORY_STALENESS_DAYS=10
MIN_BACKTEST_RESOLVED=8
MIN_BACKTEST_WIN_LOWER=45
MIN_BACKTEST_EXPECTANCY_R=0.05
MIN_BACKTEST_FILL_RATE=40
BACKTEST_ROUND_TRIP_COST_PCT=0.45

# Optional independent model council. Blank keys mean no provider is contacted;
# set this flag false as a kill switch. Council is always shadow-only.
MODEL_COUNCIL_ENABLED=true
GLM_API_KEY=
GLM_BASE_URL=https://api.z.ai/api/paas/v4
GLM_MODEL=glm-5.2
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
MODEL_COUNCIL_REQUEST_TIMEOUT=20
MODEL_COUNCIL_OVERALL_TIMEOUT=22
MODEL_COUNCIL_MAX_OUTPUT_TOKENS=800
MODEL_COUNCIL_MAX_EVIDENCE_BYTES=128000
MODEL_COUNCIL_CACHE_TTL=900
MODEL_COUNCIL_CACHE_MAX_ENTRIES=128
MODEL_COUNCIL_DAILY_BUDGET=3
MODEL_COUNCIL_ERROR_COOLDOWN=900

# Neutral macro/news layer. vimo-VN stays the source of the macro stance;
# Google News RSS supplies headline metadata without requiring another API key.
VIMO_LATEST_URL=https://raw.githubusercontent.com/maikhanhthieu-droid/vimo-VN/main/output/latest.json
VIMO_CACHE_TTL=900
VIMO_MAX_AGE_HOURS=72
NEWS_CACHE_TTL=900
NEWS_MAX_ITEMS=5
